{
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:packages:clean": "node scripts/build-packages.js",
    "verify:packages": "node scripts/verify-packages.js",
    "dev": "turbo run dev --filter=!gamba-api --no-cache --continue",
    "api": "turbo run api --filter=gamba-api",
    "api-dev": "turbo run dev --filter=gamba-api",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "turbo": "^1.13.3",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@solana/web3.js": "1.98.2",
      "@solana/spl-token": "0.4.13",
      "@solana/wallet-adapter-react": "^0.15.39",
      "tone": "15.1.22"
    },
    "ignoredBuiltDependencies": [
      "bigint-buffer",
      "blake-hash",
      "bufferutil",
      "es5-ext",
      "esbuild",
      "protobufjs",
      "tiny-secp256k1",
      "usb",
      "utf-8-validate"
    ],
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
